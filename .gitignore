# Среды окружения Python
.env
.env.local
.env.test
.venv/
venv/
env/

# Кэш Python и скомпилированные файлы
__pycache__/
*.pyc
*.pyo
*.pyd

# База данных
*.sqlite3
postgres_data/

# Инструменты разработчика
.vscode/
.idea/
.DS_Store

# Node — на случай случайного npx из корня (frontend/ имеет свой .gitignore)
node_modules/

# Прочие файлы кэша:
# Pytest
.pytest_cache/

# Mypy
.mypy_cache/

# Ruff 
.ruff_cache/

#.import-linter_cache
.import_linter_cache/

# Coverage
.coverage
htmlcov/

# Claude CLI files — сессии и память вне репо; skills и project-scope settings версионируются
.claude/*
!.claude/commands/
!.claude/commands/*.md
!.claude/settings.json
CLAUDE.local.md

# Рабочие спеки/ТЗ и заметки по проекту — не для публичного репо
docs/

# openalex_pdf_feed — личный сайд-проект (не часть продукта, см. openalex_pdf_feed/README.md
# в истории до этого коммита). Код остаётся публичным (нужен GitHub Actions), но личные
# детали — поисковые фразы и инструкция с упоминанием конкретного человека — нет.
# terms.yaml материализуется в CI из секрета OPENALEX_TERMS_YAML, см. workflow.
openalex_pdf_feed/terms.yaml
openalex_pdf_feed/README.md
